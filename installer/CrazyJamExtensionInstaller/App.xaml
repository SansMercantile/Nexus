             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <LinearGradientBrush x:Key="PrivMarkGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#f58aa8" Offset="0" />
