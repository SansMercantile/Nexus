<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>CrazyJam Extension Installer</AssemblyTitle>
    <AssemblyCompany>Sans Mercantile</AssemblyCompany>
    <Product>CrazyJam Extension Installer</Product>
    <Description>CrazyJam DAW Extension Installer for Windows</Description>
    <Version>1.0.0</Version>
    <AssemblyName>CrazyJam Extension Installer</AssemblyName>
    <RootNamespace>CrazyJamExtensionInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Legal\INSTALLATION_NOTICE.txt" LogicalName="CrazyJamExtensionInstaller.Legal.INSTALLATION_NOTICE.txt" />
    <EmbeddedResource Include="Payload\CrazyJamExtensionSetupEngine.ps1" LogicalName="CrazyJamExtensionInstaller.Payload.CrazyJamExtensionSetupEngine.ps1" />
    <EmbeddedResource Include="Payload\extensions.zip" LogicalName="CrazyJamExtensionInstaller.Payload.extensions.zip" />
  </ItemGroup>
</Project>
